# ── Base de datos ──────────────────────────────────────────────
# Supabase: Project Settings → Database → Connection string → "Transaction pooler" (puerto 6543).
# En producción es obligatoria. Sin esta variable, en desarrollo se usa una base local (PGlite).
DATABASE_URL=postgresql://postgres.xxxxxxxx:TU_CLAVE@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# ── Cuentas de acceso (Supabase Authentication) ────────────────
# URL del proyecto y clave service_role (Project Settings → API Keys). La clave es secreta: solo en el servidor.
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ── Panel de administración ────────────────────────────────────
# Clave secreta para firmar las sesiones (32 caracteres o más). Genérala con: openssl rand -hex 32
# Los usuarios que entran a /admin se crean con: npm run db:user -- <usuario> <contraseña> "<nombre>" <correo> <empresa-id>
ADMIN_SESSION_SECRET=cambia-esta-clave-por-una-de-32-caracteres-o-mas

# ── Correo (Resend) ────────────────────────────────────────────
# "resend" en producción, "console" para ver los correos en la consola y en OUTBOX_DIR.
MAIL_PROVIDER=resend
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Remitente con un dominio verificado en Resend, p. ej. "AgendaFinlandia <agenda@tudominio.cl>".
MAIL_FROM="AgendaFinlandia <agenda@tudominio.cl>"

# ── Solo desarrollo ────────────────────────────────────────────
# Carpeta de la base local (PGlite) cuando no hay DATABASE_URL.
PGLITE_DIR=./data/pglite
# Carpeta donde el proveedor de consola guarda los correos.
OUTBOX_DIR=./data/outbox
